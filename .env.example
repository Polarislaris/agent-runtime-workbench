# Copy this file to .env and replace the API key locally. Never commit .env.
ANTHROPIC_API_KEY=PASTE_YOUR_API_KEY_HERE
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
MODEL=qwen3.7-plus
FALLBACK_MODEL=qwen3.7-max

AGENT_WORKDIR=/path/to/your/project
AGENT_STATE_DIR=
AGENT_WORKTREES_DIR=
AGENT_RUN_DB=

MAX_TEAMMATES=4
MAX_BACKGROUND_TASKS=4
DEFAULT_MAX_TOKENS=8000
ESCALATED_MAX_TOKENS=64000
MAX_CONTINUATION_RETRIES=3
MAX_RETRIES=5
BASE_DELAY_MS=500
MAX_DELAY_MS=8000
WEB_PERMISSION_TIMEOUT_SECONDS=60
RUN_EVENT_RETENTION_DAYS=30
